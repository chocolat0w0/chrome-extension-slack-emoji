{
  "manifest_version": 3,
  "name": "Slack文字絵文字",
  "version": "0.6.7",
  "description": "Slackの登録画面で文字絵文字を作成します。",
  "content_scripts": [
    {
      "matches": [
        "https://*.slack.com/customize/emoji",
        "https://*.slack.com/customize/emoji?*",
        "https://*.slack.com/customize/emoji/",
        "https://*.slack.com/customize/emoji/?*"
      ],
      "js": [
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "font-worker.js"
  },
  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ]
}
